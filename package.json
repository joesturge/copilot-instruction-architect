{
  "name": "copilot-instruction-architect",
  "version": "0.1.0",
  "description": "Self-improving GitHub Copilot configuration architect. Organises, deduplicates and optimises instructions, skills, prompts and agents while capturing useful repository knowledge with minimal context.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "instruction-architect": "src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit",
    "postinstall": "chmod +x hooks/session-start.sh hooks/session-end.sh 2>/dev/null || true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joesturge/copilot-instruction-architect"
  },
  "keywords": [
    "copilot",
    "instructions",
    "ai-config"
  ],
  "author": "Joe Sturge",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "tsx": "^4.23.12"
  }
}
