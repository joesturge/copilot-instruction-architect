{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node dist/hooks/session-start.js 2>/dev/null || true",
        "powershell": "if (Test-Path dist/hooks/session-start.js) { node dist/hooks/session-start.js 2>$null }",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node dist/hooks/session-end.js 2>/dev/null || true",
        "powershell": "if (Test-Path dist/hooks/session-end.js) { node dist/hooks/session-end.js 2>$null }",
        "timeoutSec": 30
      }
    ]
  }
}
